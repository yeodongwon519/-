# AI Shorts Maker - 환경 변수 설정 템플릿
# 이 파일을 .env로 복사하고 실제 API 키를 입력하세요.
# cp .env.example .env

# Pexels API Key - 무료 영상 검색/다운로드
# 발급: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ElevenLabs API Key - AI 음성 생성 (TTS)
# 발급: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (선택사항 - 기본값: Rachel)
# 음성 목록: https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
